 "doc_rules": {
  "投保单": {
   "actor": "term in ('CIF','CIP') ? 'seller' : 'buyer'",
   "cond": "所有术语都需要投保，只是执行方不同",
   "note": "CIF/CIP 由出口商投保；FOB/FCA/CFR/CPT 由进口商投保，且须在出口商订舱完成后、货物出运前尽早办理"
  },
  "商业发票": {
   "actor": "seller"
  },
  "装箱单": {
   "actor": "seller"
  },
  "合同（外销合同）": {
   "actor": "seller",
   "note": "合同只能由出口商起草"
  },
  "出口货物报关单": {
   "actor": "seller"
  },
  "进口货物报关单": {
   "actor": "buyer"
  },
  "国际海运委托书": {
   "actor": "seller",
   "cond": "transport=='海运'"
  },
  "国际空运委托书": {
   "actor": "seller",
   "cond": "transport=='空运'"
  },
  "托收委托书": {
   "actor": "seller",
   "cond": "payment in ('D/P','D/A')"
  },
  "汇票": {
   "actor": "seller",
   "cond": "payment in ('L/C','D/P','D/A')"
  },
  "出口押汇申请书": {
   "actor": "seller",
   "cond": "选择押汇（与仅交单二选一）"
  },
  "不可撤销信用证开证申请书": {
   "actor": "buyer",
   "cond": "payment=='L/C'"
  },
  "信用证修改申请书": {
   "actor": "buyer",
   "cond": "payment=='L/C' 且需修改"
  },
  "境外汇款申请书": {
   "actor": "buyer",
   "cond": "payment=='T/T'"
  },
  "境内汇款申请书": {
   "actor": "seller 付运费 / buyer 国内付款",
   "cond": ""
  },
  "出境货物检验检疫申请": {
   "actor": "seller"
  },
  "入境货物检验检疫申请": {
   "actor": "buyer"
  },
  "一般原产地证": {
   "actor": "seller",
   "cond": "进口国要求一般原产地证（如美国）"
  },
  "普惠制产地证": {
   "actor": "seller",
   "cond": "进口国可享普惠制"
  },
  "申请鉴定表": {
   "actor": "seller",
   "cond": "商品需做货物运输条件鉴定（21001/40001/40002/06002）"
  },
  "索赔申请书": {
   "actor": "buyer",
   "cond": "货物出险"
  }
 }
}